{
	"semi": true,
	"trailingComma": "es5",
	"singleQuote": true,
	"tabWidth": 4,
	"useTabs": false,
	"printWidth": 80,
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"endOfLine": "lf",
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"htmlWhitespaceSensitivity": "css",
	"embeddedLanguageFormatting": "auto",
	"singleAttributePerLine": false,
	"overrides": [
		{
			"files": "*.scss",
			"options": {
				"singleQuote": false
			}
		},
		{
			"files": "*.json",
			"options": {
				"trailingComma": "none"
			}
		}
	]
}