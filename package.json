{
    "name": "portfolio-app",
    "author": "Temnikov Rodion",
    "description": "2026 year",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:gh-pages": "set GITHUB_PAGES=true && next build",
        "deploy": "npm run build:gh-pages && gh-pages -d out -b gh-pages --dotfiles",
        "start": "next start",
        "lint": "eslint .",
        "lint:strict": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "type-check": "tsc --noEmit",
        "type-check:watch": "tsc --noEmit --watch",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,scss,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,scss,css,md}\"",
        "validate": "npm run type-check && npm run lint:strict && npm run format:check",
        "validate:dev": "npm run type-check && npm run lint && npm run format:check",
        "fix": "npm run lint:fix && npm run format",
        "prepare": "husky",
        "deploy:win": ".\\scripts\\deploy.bat",
        "deploy:bash": "bash scripts/deploy.sh"
    },
    "dependencies": {
        "@ant-design/icons": "^6.2.5",
        "@ant-design/nextjs-registry": "^1.3.0",
        "antd": "^6.4.3",
        "dayjs": "^1.11.21",
        "next": "16.2.7",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "sass": "^1.100.0"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.2.7",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20.19.41",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.7",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "gh-pages": "^6.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{json,scss,css,md}": [
            "prettier --write"
        ]
    }
}
